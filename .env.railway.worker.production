# Swift AI - Railway Dedicated Generation Worker Production Environment
# Use this file as the Railway Variables checklist for workers/Dockerfile.
# Replace every REPLACE_WITH_* value in Railway Variables before deploy.

NODE_ENV=production
PORT=4000
SWIFT_WORKER_HEALTH_PORT=4000
SWIFT_WORKER_TYPE=generation

SWIFT_GENERATION_EXECUTION_MODE=queue
SWIFT_ALLOW_SERVERLESS_GENERATION_FALLBACK=false
SWIFT_DISABLE_SERVERLESS_GENERATION_FALLBACK=true
SWIFT_REDIS_AUTO_SET_NOEVICTION=true
SWIFT_ENABLE_GENERATION_WORKER=true
SWIFT_GENERATION_WORKER_CONCURRENCY=2
SWIFT_WORKER_HEARTBEAT_INTERVAL_MS=15000
SWIFT_WORKER_RECOVERY_INTERVAL_MS=60000
SWIFT_GENERATION_JOB_TIMEOUT_MS=500000
SWIFT_STALE_GENERATION_TIMEOUT_MS=500000
SANDBOX_SERVICE_TIMEOUT_MS=300000

DATABASE_URL=REPLACE_WITH_NEON_POOLER_DATABASE_URL
DIRECT_DATABASE_URL=REPLACE_WITH_NEON_DIRECT_DATABASE_URL
REDIS_URL=REPLACE_WITH_NATIVE_REDIS_URL

OPENROUTER_API_KEY=REPLACE_WITH_OPENROUTER_API_KEY
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://www.ai-swift.biz.id
OPENROUTER_APP_NAME=Swift AI
SWIFT_PRIMARY_MODEL=deepseek/deepseek-v4-pro
SWIFT_FALLBACK_MODEL_1=openai/gpt-oss-120b:free
OPENROUTER_DEEPSEEK_V4_PRO_MODEL=deepseek/deepseek-v4-pro
SWIFT_AI_FREE_MODE=true
OPENROUTER_FREE_MODEL=openai/gpt-oss-120b:free
OPENROUTER_MAX_TOKENS=16000
AI_TIMEOUT_MS=500000
AI_MAX_RETRIES=5
AI_MAX_INPUT_TOKENS=24000
AI_MAX_OUTPUT_TOKENS=16000
AI_MAX_CONCURRENT_GENERATIONS=2
AI_QUEUE_TIMEOUT_MS=500000
PROVIDER_STATUS_CACHE_TTL_MS=86400000

SANDBOX_SERVICE_URL=https://swift-sandbox-service-production.up.railway.app
SANDBOX_SERVICE_TOKEN=REPLACE_WITH_RAILWAY_SANDBOX_TOKEN
SANDBOX_PUBLIC_BASE_URL=https://swift-sandbox-service-production.up.railway.app

NEXT_PUBLIC_SUPABASE_URL=REPLACE_WITH_SUPABASE_PROJECT_URL
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=REPLACE_WITH_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=REPLACE_WITH_SUPABASE_STORAGE_BUCKET
