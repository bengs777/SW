generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User accounts from Google OAuth
model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String?
  image         String?
  passwordHash  String?
  balance       Int        @default(0)
  isDeveloperAccount Boolean @default(false)
  welcomeBonusGrantedAt DateTime?
  emailVerified DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Relations
  workspaces    Workspace[]
  memberships   WorkspaceMember[]
  accounts      Account[]
  sessions      Session[]
  usageLogs     UsageLog[]
  billingTransactions BillingTransaction[]
  topUpOrders   TopUpOrder[]
  creditGrantsSent CreditGrant[] @relation("CreditGrantFromUser")
  creditGrantsReceived CreditGrant[] @relation("CreditGrantToUser")
  creditGrantsCreated CreditGrant[] @relation("CreditGrantCreatedBy")
  creditGrantsReversed CreditGrant[] @relation("CreditGrantReversedBy")
  billingTransactionsAsActor BillingTransaction[] @relation("BillingTransactionActor")
  billingTransactionsAsCounterparty BillingTransaction[] @relation("BillingTransactionCounterparty")
  uploadedAssets ProjectAsset[]
  generationJobs GenerationJob[]
  products Product[]

  @@index([email])
  @@index([isDeveloperAccount])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String
  area        String   @default("Online")
  price       Int
  status      String   @default("draft")
  ownerId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([status])
  @@index([createdAt])
}

// OAuth accounts
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Sessions for NextAuth
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Verification tokens
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Workspaces (organizations in SaaS)
model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  image     String?
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  creator   User                @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  members   WorkspaceMember[]
  projects  Project[]
  apiKeys   ApiKey[]
  subscription Subscription?

  @@index([createdBy])
  @@index([slug])
}

// Workspace membership with roles
model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String   @default("member") // admin, editor, viewer
  joinedAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

// Projects within workspaces
model Project {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  framework   String   @default("next")
  prompt      String?
  templateId  String?
  customDomain String?
  domainVerified Boolean @default(false)
  memoryJson  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  files     ProjectFile[]
  history   GenerationHistory[]
  requestLogs RequestLog[]
  projectAssets ProjectAsset[]
  generationJobs GenerationJob[]
  artifacts Artifact[]

  @@index([workspaceId])
  @@index([templateId])
}

// Generated files per project
model ProjectFile {
  id        String   @id @default(cuid())
  projectId String
  path      String
  content   String
  language  String   @default("typescript")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@unique([projectId, path])
}

model ProjectAsset {
  id            String   @id @default(cuid())
  projectId     String
  userId        String
  originalName  String
  mimeType      String
  size          Int
  kind          String
  storageBucket String
  storagePath   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storageBucket, storagePath])
  @@index([projectId])
  @@index([userId])
}

// Track generation history
model GenerationHistory {
  id          String   @id @default(cuid())
  projectId   String
  prompt      String
  result      String
  tokensUsed  Int      @default(0)
  intent      String?
  usedAutoRepair Boolean @default(false) @map("used_auto_repair")
  idempotencyKey String?
  cost           Decimal  @default(0)
  createdAt      DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  artifact Artifact?

  @@index([projectId])
  @@index([createdAt])
  @@unique([projectId, idempotencyKey])
}

model GenerationJob {
  id              String   @id @default(cuid())
  userId          String
  projectId       String
  prompt          String
  model           String
  provider        String   @default("swift")
  intent          String?
  usedAutoRepair  Boolean  @default(false) @map("used_auto_repair")
  status          String   @default("queued")
  orchestrationState String @default("queued")
  stage           String   @default("queued")
  label           String   @default("Prompt diterima")
  progress        Int      @default(0)
  version         Int      @default(0)
  retryCount      Int      @default(0)
  maxRetries      Int      @default(2)
  attemptCount    Int      @default(0)
  planJson        String?
  contextJson     String?
  diagnosticsJson String?
  metricsJson     String?
  previewUrl      String?
  error           String?
  resultHistoryId String?
  queueJobId      String?
  traceId         String?
  workerId        String?
  leaseOwner      String?
  leaseExpiresAt  DateTime?
  lastHeartbeatAt DateTime?
  retryReason     String?
  retryClass      String?
  recoveryCount   Int      @default(0)
  deadLetteredAt  DateTime?
  terminatedAt    DateTime?
  idempotencyKey  String?
  requestHash     String?
  cancelRequested Boolean  @default(false)
  cancelReason    String?
  timedOutAt      DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  failedAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  events  GenerationEvent[]
  attempts GenerationAttempt[]
  repairAttempts RepairAttempt[]
  previewSessions PreviewSession[]
  orchestrationFailures OrchestrationFailure[]
  qualityMetric GenerationQualityMetric?
  artifact Artifact?

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([status])
  @@index([orchestrationState])
  @@index([stage])
  @@index([cancelRequested])
  @@index([queueJobId])
  @@index([traceId])
  @@index([workerId])
  @@index([leaseOwner])
  @@index([leaseExpiresAt])
  @@index([lastHeartbeatAt])
  @@unique([userId, projectId, idempotencyKey])
  @@unique([userId, projectId, requestHash])
}

model Artifact {
  id                  String   @id @default(cuid())
  projectId           String
  generationJobId     String?  @unique
  generationHistoryId String?  @unique
  source              String   @default("generation")
  status              String   @default("candidate")
  version             Int      @default(1)
  prompt              String?
  metadataJson        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  generationJob     GenerationJob?     @relation(fields: [generationJobId], references: [id], onDelete: SetNull)
  generationHistory GenerationHistory? @relation(fields: [generationHistoryId], references: [id], onDelete: SetNull)
  files             ArtifactFile[]

  @@index([projectId, createdAt])
  @@index([status, createdAt])
  @@index([source])
}

model ArtifactFile {
  id          String   @id @default(cuid())
  artifactId  String
  path        String
  content     String
  language    String   @default("typescript")
  sizeBytes   Int      @default(0)
  contentHash String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  artifact Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@unique([artifactId, path])
  @@index([artifactId])
  @@index([contentHash])
}

model GenerationQualityMetric {
  id                 String   @id @default(cuid())
  jobId              String   @unique
  userId             String
  projectId          String
  appType            String
  status             String
  failureStage       String?
  failureCode        String?
  buildPassed        Boolean  @default(false)
  runtimePassed      Boolean  @default(false)
  repairSucceeded    Boolean  @default(false)
  deployValidated    Boolean  @default(false)
  repairAttempts     Int      @default(0)
  userRetryCount     Int      @default(0)
  providerLatencyMs  Int      @default(0)
  validationLatencyMs Int     @default(0)
  totalLatencyMs     Int      @default(0)
  promptTokens       Int      @default(0)
  completionTokens   Int      @default(0)
  totalTokens        Int      @default(0)
  estimatedCost      Int      @default(0)
  metadataJson       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  job GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([appType, createdAt])
  @@index([status, createdAt])
  @@index([failureStage])
}

model GenerationEvent {
  id        String   @id @default(cuid())
  jobId      String
  traceId    String?
  spanId     String?
  parentSpanId String?
  workerId   String?
  sandboxId  String?
  previewId  String?
  sequence   Int
  type       String
  eventType  String?
  stage      String
  status     String
  message    String
  dataJson   String?
  metadataJson String?
  retryCount Int      @default(0)
  terminationReason String?
  createdAt  DateTime @default(now())

  job GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, sequence])
  @@index([jobId, createdAt])
  @@index([jobId, sequence])
  @@index([type])
  @@index([eventType])
  @@index([traceId])
  @@index([workerId])
  @@index([previewId])
}

model RepairAttempt {
  id                 String   @id @default(cuid())
  jobId              String
  traceId            String?
  spanId             String?
  workerId           String?
  attempt            Int
  status             String
  reason             String?
  terminationReason  String?
  validatorError     String?
  inputHash          String?
  outputHash         String?
  idempotencyKey     String?
  metadataJson       String?
  startedAt          DateTime @default(now())
  completedAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  job GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, attempt])
  @@unique([jobId, idempotencyKey])
  @@index([jobId, startedAt])
  @@index([status])
  @@index([terminationReason])
  @@index([traceId])
}

model PreviewSession {
  id                 String   @id @default(cuid())
  jobId              String
  projectId          String
  traceId            String?
  spanId             String?
  workerId           String?
  sandboxId          String?
  previewUrl         String?
  status             String   @default("starting")
  bootStartedAt      DateTime?
  buildStartedAt     DateTime?
  buildCompletedAt   DateTime?
  devServerStartedAt DateTime?
  reachableAt        DateTime?
  terminatedAt       DateTime?
  terminationReason  String?
  expiresAt          DateTime?
  idempotencyKey     String?
  diagnosticsJson    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  job GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, idempotencyKey])
  @@index([jobId, createdAt])
  @@index([projectId, createdAt])
  @@index([status])
  @@index([traceId])
  @@index([sandboxId])
  @@index([expiresAt])
}

model WorkerHeartbeat {
  id                       String   @id @default(cuid())
  workerId                 String   @unique
  traceId                  String?
  currentJobId             String?
  currentStage             String?
  lastSuccessfulTransition String?
  leaseOwner               String?
  leaseExpiresAt           DateTime?
  runtimeInfoJson          String?
  metadataJson             String?
  heartbeatAt              DateTime @default(now())
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([heartbeatAt])
  @@index([currentJobId])
  @@index([currentStage])
  @@index([leaseExpiresAt])
}

model OrchestrationFailure {
  id                 String   @id @default(cuid())
  jobId              String
  traceId            String?
  workerId           String?
  eventType          String
  stage              String
  severity           String   @default("error")
  reason             String
  retryCount         Int      @default(0)
  terminationReason  String?
  metadataJson       String?
  createdAt          DateTime @default(now())

  job GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
  @@index([traceId])
  @@index([workerId])
  @@index([eventType])
  @@index([severity])
  @@index([terminationReason])
  @@index([createdAt])
}

model GenerationAttempt {
  id               String   @id @default(cuid())
  jobId             String
  sequence          Int
  provider          String
  model             String
  purpose           String
  status            String
  startedAt         DateTime @default(now())
  completedAt       DateTime?
  latencyMs         Int      @default(0)
  promptTokens      Int      @default(0)
  completionTokens  Int      @default(0)
  totalTokens       Int      @default(0)
  error             String?
  metadataJson      String?

  job GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, sequence])
  @@index([jobId, startedAt])
  @@index([provider, model])
  @@index([status])
}

// Request telemetry and diagnostics for AI operations
model RequestLog {
  id            String   @id @default(cuid())
  projectId     String
  taskType      String
  modelConfigId String?
  modelUsed     String
  provider      String?
  latencyMs     Int      @default(0)
  tokens        Int      @default(0)
  success       Boolean  @default(false)
  errorMessage  String?
  contextJson   String?
  createdAt     DateTime @default(now())

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  modelConfig ModelConfig? @relation(fields: [modelConfigId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([taskType])
  @@index([modelUsed])
  @@index([provider])
  @@index([success])
}

// API Keys for workspace
model ApiKey {
  id          String   @id @default(cuid())
  workspaceId String
  key         String   @unique
  name        String
  lastUsed    DateTime?
  createdAt   DateTime @default(now())
  expiresAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([key])
}

// Subscription/Billing
model Subscription {
  id            String   @id @default(cuid())
  workspaceId   String   @unique
  plan          String   @default("free") // free, pro, enterprise
  status        String   @default("active") // active, canceled, past_due
  tokensLimit   Int      @default(10000)
  tokensUsed    Int      @default(0)
  renewalDate   DateTime?
  canceledAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model BillingTransaction {
  id                String   @id @default(cuid())
  userId            String
  grantId           String?
  actorUserId       String?
  counterpartyUserId String?
  kind              String
  direction         String
  amount            Int
  balanceBefore     Int
  balanceAfter      Int
  reference         String?  @unique
  provider          String?
  providerReference String?
  description       String?
  metadata          String?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  grant CreditGrant? @relation(fields: [grantId], references: [id], onDelete: SetNull)
  actor User? @relation("BillingTransactionActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  counterparty User? @relation("BillingTransactionCounterparty", fields: [counterpartyUserId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([grantId])
  @@index([actorUserId])
  @@index([counterpartyUserId])
  @@index([kind])
  @@index([provider, providerReference])
  @@index([createdAt])
}

model CreditGrant {
  id                String   @id @default(cuid())
  reference         String   @unique
  fromUserId        String
  toUserId          String
  amount            Int
  reason            String
  note              String?
  status            String   @default("posted")
  createdByUserId   String
  reversedByUserId  String?
  idempotencyKey    String?  @unique
  postedAt          DateTime?
  reversedAt        DateTime?
  metadata          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  fromUser User @relation("CreditGrantFromUser", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser User @relation("CreditGrantToUser", fields: [toUserId], references: [id], onDelete: Cascade)
  createdBy User @relation("CreditGrantCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  reversedBy User? @relation("CreditGrantReversedBy", fields: [reversedByUserId], references: [id], onDelete: SetNull)
  billingTransactions BillingTransaction[]

  @@index([fromUserId])
  @@index([toUserId])
  @@index([createdByUserId])
  @@index([reversedByUserId])
  @@index([status])
  @@index([createdAt])
}

model TopUpOrder {
  id                String   @id @default(cuid())
  userId            String
  reference         String   @unique
  provider          String   @default("pakasir") // "pakasir" or "crypto"
  providerReference String?  @unique
  amount            Int
  status            String   @default("pending")
  checkoutUrl       String?
  paymentCode       String?
  customerName      String?
  customerEmail     String?
  payload           String?
  response          String?
  paidAt            DateTime?
  expiresAt         DateTime?
  
  // EVM Crypto Fields
  chainId           Int?
  walletAddress     String?
  tokenAmount       String?     // For crypto: in wei/decimal format
  transactionHash   String?     // Optional until transaction is detected
  requiresConfirms  Int?        @default(2)
  confirmCount      Int?        @default(0)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  cryptoPayment CryptoPayment?

  @@index([userId])
  @@index([status])
  @@index([provider, reference])
  @@index([transactionHash])
  @@index([chainId, walletAddress])
}

model CryptoPayment {
  id                String   @id @default(cuid())
  topUpOrderId      String   @unique
  chainId           Int      // 56 for BSC, 8453 for Base
  chainName         String   // "BNB Chain" or "Base"
  tokenSymbol       String   @default("Native") // "ETH" for Base, "BNB" for BSC
  amountInUsd       Int      // stored in cents
  amountInToken     String   // decimal string
  senderAddress     String
  recipientAddress  String
  transactionHash   String?  // Optional until transaction is detected
  blockNumber       Int?
  confirmations     Int      @default(0)
  gasUsed           String?
  gasPriceInGwei    String?
  status            String   @default("pending") // pending, confirming, confirmed, failed
  errorMessage      String?
  detectedAt        DateTime @default(now())
  confirmedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  topUpOrder TopUpOrder @relation(fields: [topUpOrderId], references: [id], onDelete: Cascade)

  @@index([chainId, transactionHash])
  @@index([senderAddress])
  @@index([status])
  @@index([detectedAt])
}

model ModelConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  provider  String
  modelName String
  price     Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usageLogs UsageLog[]
  requestLogs RequestLog[]

  @@index([provider])
  @@index([isActive])
}

// Aggregated model performance scores per task type
model ModelScore {
  id          String   @id @default(cuid())
  modelName   String
  taskType    String
  provider    String?
  successRate Float    @default(0)
  avgLatency  Int      @default(0)
  avgRating   Float    @default(0)
  sampleCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([modelName, taskType])
  @@index([taskType])
  @@index([modelName])
  @@index([provider])
}

model UsageLog {
  id           String      @id @default(cuid())
  userId       String
  modelConfigId String
  model        String
  provider     String
  cost         Int
  prompt       String
  status       String      @default("pending")
  errorMessage String?
  refundedAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  modelConfig ModelConfig @relation(fields: [modelConfigId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([model])
  @@index([status])
}
