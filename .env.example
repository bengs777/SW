NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_secure_secret
PORT=3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Use Neon's pooled connection string for app/runtime traffic.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
# Use Neon's direct/non-pooling connection string for migrations and admin scripts.
DIRECT_DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

DEV_OWNER_EMAIL=your_email@example.com
DEV_OWNER_NAME=

AI_TIMEOUT_MS=500000
AI_MAX_RETRIES=2
AI_MAX_INPUT_TOKENS=12000
AI_MAX_CONCURRENT_GENERATIONS=2
AI_QUEUE_TIMEOUT_MS=500000
SWIFT_GENERATION_JOB_TIMEOUT_MS=500000
SWIFT_STALE_GENERATION_TIMEOUT_MS=500000
SANDBOX_SERVICE_TIMEOUT_MS=300000
PROVIDER_STATUS_CACHE_TTL_MS=86400000
AI_RATE_LIMIT_PER_MINUTE=12
AI_GENERATION_RATE_LIMIT_PER_HOUR=60
UPLOAD_RATE_LIMIT_PER_DAY=100
DB_CONNECTION_LIMIT=8
DB_POOL_TIMEOUT_SECONDS=10
DB_QUERY_TIMEOUT_MS=10000
DB_MAX_RETRIES=2
DB_RETRY_BASE_DELAY_MS=250
DB_CIRCUIT_FAILURE_THRESHOLD=50
DB_CIRCUIT_COOLDOWN_MS=30000
SWIFT_WORKER_HEARTBEAT_INTERVAL_MS=15000
SWIFT_WORKER_RECOVERY_INTERVAL_MS=60000
SWIFT_REDIS_AUTO_SET_NOEVICTION=false

OPENROUTER_API_KEY=replace_with_openrouter_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://swift.biz.id
OPENROUTER_APP_NAME=Swift AI
# Preferred Swift model routing. If empty, Swift injects the built-in default OpenRouter chain.
SWIFT_AI_MODEL_CHAIN=openrouter:deepseek/deepseek-v4-pro,openrouter:anthropic/claude-sonnet-4,openrouter:openai/gpt-4.1-mini
# Swift model routing. Large/full-stack generation starts from primary; edit/UI patch starts from fallback 1.
SWIFT_PRIMARY_MODEL=deepseek/deepseek-v4-pro
SWIFT_FALLBACK_MODEL_1=anthropic/claude-sonnet-4
SWIFT_FALLBACK_MODEL_2=openai/gpt-4.1-mini
SWIFT_FALLBACK_MODEL_3=
SWIFT_AI_FREE_MODE=false
OPENROUTER_MAX_TOKENS=16000
AI_MAX_OUTPUT_TOKENS=16000
SWIFT_USD_TO_IDR=16000
SWIFT_PRIMARY_INPUT_USD_PER_1M=0.435
SWIFT_PRIMARY_OUTPUT_USD_PER_1M=0.87
SWIFT_FAST_PRICE_IDR=4000
SWIFT_BUILDER_PRICE_IDR=22000
SWIFT_PREMIUM_REPAIR_PRICE_IDR=50000

REDIS_URL=
SWIFT_GENERATION_EXECUTION_MODE=queue
SWIFT_ALLOW_SERVERLESS_GENERATION_FALLBACK=false
SWIFT_DISABLE_SERVERLESS_GENERATION_FALLBACK=true
SWIFT_REDIS_AUTO_SET_NOEVICTION=true
SWIFT_GENERATION_WORKER_CONCURRENCY=2
SANDBOX_SERVICE_URL=
SANDBOX_SERVICE_TOKEN=
SANDBOX_PUBLIC_BASE_URL=
SWIFT_SANDBOX_ROOT=
SWIFT_SANDBOX_BASE_PORT=4300
SWIFT_SANDBOX_DATABASE_URL=
SWIFT_SANDBOX_MAX_PROJECTS=12
SWIFT_SANDBOX_MAX_FILES=240
SWIFT_SANDBOX_MAX_TOTAL_BYTES=6291456
SWIFT_SANDBOX_MAX_FILE_BYTES=524288
SWIFT_SANDBOX_PROJECT_IDLE_TTL_MS=1800000
SWIFT_SANDBOX_PROCESS_MAX_UPTIME_MS=1200000
SWIFT_SANDBOX_ALLOWED_PACKAGES=
SWIFT_SANDBOX_ALLOW_UNSAFE_PACKAGE_INSTALL=0

DEPLOY_PROVIDER=disabled
DEPLOY_API_TOKEN=
DEPLOY_BASE_URL=
